{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#8AADF4",
    "closer": "p:os",
    "lavender": "#B7BDF8",
    "os": "#ACB0BE",
    "pink": "#F5BDE6"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{.Icon}} ",
          "foreground": "p:os",
          "type": "os",
          "style": "plain"
        },
        {
          "template": "{{ .UserName }}@{{ .HostName }} ",
          "foreground": "p:blue",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": "{{ .Path }} ",
          "foreground": "p:pink",
          "type": "path",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "{{ .HEAD }} ",
          "foreground": "p:lavender",
          "type": "git",
          "style": "plain"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#FFD43B",
          "template": "\ue235 {{ .Full }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#6CA35E",
          "template": "\ue718 {{ .Full }} "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#00ACD7",
          "template": "\ue627 {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#DEA584",
          "template": "\ue7a8 {{ .Full }} "
        },
        {
          "type": "java",
          "style": "plain",
          "foreground": "#ED8B00",
          "template": "\ue256 {{ .Full }} "
        },
        {
          "type": "ruby",
          "style": "plain",
          "foreground": "#CC342D",
          "template": "\ue791 {{ .Full }} "
        },
        {
          "type": "docker",
          "style": "plain",
          "foreground": "#2496ED",
          "template": "\uf308 {{ .Context }} "
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#512BD4",
          "template": "\ue77f {{ .Full }} "
        },
        {
          "type": "lua",
          "style": "plain",
          "foreground": "#000080",
          "template": "\ue620 {{ .Full }} "
        },
        {
          "type": "php",
          "style": "plain",
          "foreground": "#777BB4",
          "template": "\ue608 {{ .Full }} "
        },
        {
          "type": "terraform",
          "style": "plain",
          "foreground": "#7B42BC",
          "template": "\udb84\udc62 {{ .Version }} "
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "#326CE5",
          "template": "\udb84\udcfe {{ .Context }}{{ if .Namespace }}/{{ .Namespace }}{{ end }} "
        },
        {
          "template": "\uf105",
          "foreground": "p:closer",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
